<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CounterStrikeSharp.API">
      <HintPath>../../api/CounterStrikeSharp.API.dll</HintPath>
    </Reference>

    <Reference Include="permission_manager_api">
      <HintPath>shared/permission_manager_api/permission_manager_api.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- tests/ and shared/ have their own csproj files and must stay out of the plugin assembly -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
    <None Include="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="shared/**" />
    <EmbeddedResource Remove="shared/**" />
    <None Remove="shared/**" />
    <None Include="shared/**" />
  </ItemGroup>
</Project>